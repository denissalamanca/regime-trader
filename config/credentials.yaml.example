# Copy this file to credentials.yaml and fill in your API keys.
# credentials.yaml is gitignored — never commit real keys.

alpaca:
  api_key: "your_api_key_here"
  secret_key: "your_secret_key_here"
  base_url: "https://paper-api.alpaca.markets"  # Use paper trading URL for testing

alerts:
  smtp:
    host: "smtp.gmail.com"
    port: 587
    user: "your_email@gmail.com"
    password: "your_app_password_here"
  email_to: "your_alert_email@gmail.com"
  twilio:
    sid: "your_twilio_sid"
    auth_token: "your_twilio_auth_token"
    from_number: "+1234567890"
    to_number: "+1234567890"
